{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auth-lab",
  // No account id or resource ids here (the repo is public): Wrangler takes the account from CLOUDFLARE_ACCOUNT_ID
  // (Workers Builds sets it) and finds the D1 database by its name.
  "compatibility_date": "2026-10-01",
  // better-auth uses node:crypto and AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // The Worker only answers /api/*; everything else is the single-page app.
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // better-auth's tables (migrations/0001, generated by `pnpm auth:schema`) and the app's own (0002, 0003).
  "d1_databases": [{ "binding": "DB", "database_name": "auth-lab", "migrations_dir": "migrations" }],
  // Cloudflare Email Service; atlesque.dev is onboarded for sending.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["auth-lab@atlesque.dev"] }],
  "vars": {
    "BETTER_AUTH_URL": "https://auth-lab.atlesque.dev",
    "MAIL_FROM": "auth-lab@atlesque.dev",
    "EXTRA_ORIGINS": "",
    "DEV_MAILBOX": ""
  },
  // Secrets (wrangler secret put), so they stay out of the repo:
  //   BETTER_AUTH_SECRET
  //   SIGNUP_ALLOW    who may create an account: comma-separated domains and full addresses. Invited addresses may
  //                   always join. Not set = anyone.
  //   ADMIN_EMAILS    comma-separated addresses that get the admin role once verified.
  //   GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET   turn on GitHub sign-in.
  "observability": { "enabled": true },
  "routes": [{ "pattern": "auth-lab.atlesque.dev", "custom_domain": true }],
  // `pnpm dev:api` / launch config "auth-lab-api": local D1, emails kept in the dev_outbox table (see /dev/mailbox).
  "env": {
    "dev": {
      "routes": [],
      "d1_databases": [{ "binding": "DB", "database_name": "auth-lab", "migrations_dir": "migrations" }],
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:8890",
        "MAIL_FROM": "auth-lab@atlesque.dev",
        "EXTRA_ORIGINS": "http://localhost:3390",
        "SIGNUP_ALLOW": "example.com",
        "ADMIN_EMAILS": "admin@example.com",
        "DEV_MAILBOX": "1"
      }
    }
  }
}
